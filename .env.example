# Điền tên miền thật (không có dấu / ở cuối) trước khi build để thẻ chia sẻ Zalo/Facebook có URL tuyệt đối
# Ví dụ: VITE_SITE_URL=https://thiepcuoi.tenmiencuaban.com
VITE_SITE_URL=

# URL Google Apps Script Web App (/exec) để lưu Xác nhận tham dự & đồng bộ lời chúc từ Google Sheets
# Để trống sẽ dùng LocalStorage trên trình duyệt
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/AKfycbwwo0EGb0FyrJ_e7JCz63hA1GKhCssZcUcLuKsZzSEvNVy33WhFTv7keXhxZfLwcx0tng/exec
